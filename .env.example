# Exemplo (Linux/macOS):
# WORKSPACE_PATH=/home/seu-usuario/meu-projeto/workspace
# Exemplo (Windows - use barras normais):
# WORKSPACE_PATH=C:/Users/SeuUsuario/Documents/meu-projeto/workspace

#INSTANCE permite varios containers de mesma imagem. Mude o valor pra criar diferentes
WORKSPACE_PATH=/home/seu-usuario/meu-projeto/workspace
ROS_VERSION=version
INSTANCE=1
